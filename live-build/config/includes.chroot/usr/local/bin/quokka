#!/bin/bash
# quokka — ちょっとしたイースターエッグ。
# ターミナルで素の `quokka` と打った人へのご褒美。

MESSAGES=(
  "今日も一日、スマイル・スキャン・セキュア。"
  "クオッカは世界一幸せな動物と言われている。あなたのrootシェルもそうありますように。"
  "ヒント: nmapのスキャンを待つ間、クオッカの画像で検索すると幸福度が上がるらしい(未検証)。"
  "sudo クオッカ にはなれないが、sudo quokka-fire start にはなれる。"
  "壁紙に隠れているクオッカの回路ロゴ、よく見ると笑っている。"
  "本日の格言: パスワードは使い回さない。クオッカも群れを使い回さない(たぶん)。"
  "quokka-report initを打つと、あなたの案件フォルダにもう1匹クオッカが増える(比喩)。"
  "深夜のペンテスト、お疲れ様です。水分補給を忘れずに。"
)

RARE_CHANCE=20  # 1/20 でレアメッセージ

pick=$(( RANDOM % RARE_CHANCE ))

if [ "$pick" -eq 0 ]; then
  cat <<'EOF'

        .-""-.     .-""-.
     :      ````      :
    /    (^)     (^)    \      < 見つけてくれてありがとう。
   |                      |      これはQuokka OSの隠しコマンドです。
   |        \____/        |
    \                    /
     `.                ,'
       `--..______..--'

EOF
  echo "  レア演出、当たりです(確率 1/${RARE_CHANCE})。良い一日を。"
  exit 0
fi

idx=$(( RANDOM % ${#MESSAGES[@]} ))
echo
echo "  🐾 ${MESSAGES[$idx]}"
echo
