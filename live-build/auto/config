#!/bin/sh
# Quokka OS — live-build auto/config
# QUOKKA_PROFILE=standard|full を受け取り、Full限定package-listを切り替える
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BASE_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
cd "$BASE_DIR"

PROFILE="${QUOKKA_PROFILE:-standard}"
PKG_DIR="config/package-lists"

enable_full_list() {
    base="$1"
    target="$PKG_DIR/${base}.list.chroot"
    source_file="${target}.disabled"

    [ -f "$source_file" ] || return 0
    rm -f "$target"
    ln -s "$(basename "$source_file")" "$target"
}

disable_full_list() {
    base="$1"
    target="$PKG_DIR/${base}.list.chroot"

    if [ -L "$target" ]; then
        rm -f "$target"
    fi
}

case "$PROFILE" in
    standard)
        ISO_APPLICATION="Quokka OS"
        ISO_VOLUME="Quokka OS Standard"
        disable_full_list quokka-exploit
        disable_full_list quokka-wireless
        ;;
    full)
        ISO_APPLICATION="Quokka OS Full"
        ISO_VOLUME="Quokka OS Full"
        enable_full_list quokka-exploit
        enable_full_list quokka-wireless
        ;;
    *)
        echo "Unsupported QUOKKA_PROFILE: $PROFILE" >&2
        echo "Use standard or full." >&2
        exit 1
        ;;
 esac

export QUOKKA_PROFILE="$PROFILE"
printf '==> QUOKKA_PROFILE=%s\n' "$QUOKKA_PROFILE"

lb config noauto \
    --mode debian \
    --distribution bookworm \
    --archive-areas "main contrib non-free non-free-firmware" \
    --parent-mirror-bootstrap "http://debian.org" \
    --parent-mirror-binary "http://debian.org" \
    --mirror-bootstrap "http://debian.org" \
    --mirror-chroot "http://debian.org" \
    --mirror-binary "http://debian.org" \
    --binary-images iso-hybrid \
    --bootappend-live "boot=live components quiet splash" \
    --bootappend-install "auto=true priority=critical quiet" \
    --iso-application "$ISO_APPLICATION" \
    --iso-publisher "Quokka OS Project" \
    --iso-volume "$ISO_VOLUME" \
    --linux-packages "linux-image" \
    --debian-installer live \
    --debian-installer-gui true \
    --win32-loader false \
    "$@"

