<?xml version="1.0" encoding="UTF-8"?>

<!--
  Quokka OS default desktop background.
  正直な制約: モニタープロパティ名(monitor0)はXFCEの実機環境によって
  monitorVGA-1等に変わる場合があり、その場合は反映されない可能性がある
  (quokka-tweaksの壁紙切り替え機能と同じ前提を採用)。
-->
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/quokka/quokka-wallpaper-1920x1080.png"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
</channel>
