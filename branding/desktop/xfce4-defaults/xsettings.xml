<?xml version="1.0" encoding="UTF-8"?>

<!--
  Quokka OS default xfconf xsettings.
  Deployed to /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
  so every new user account (live user or installer-created account,
  both populated from /etc/skel) starts on-brand without manual setup.
-->
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Qogir-Dark"/>
    <property name="IconThemeName" type="string" value="Qogir-Dark"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="Noto Sans CJK JP 10"/>
    <property name="MonospaceFontName" type="string" value="JetBrains Mono 10"/>
    <property name="CursorThemeName" type="string" value="Quokka-Cyan"/>
  </property>
</channel>
